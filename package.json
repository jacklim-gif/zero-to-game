{
  "name": "virtual-unity",
  "productName": "Virtual Unity",
  "version": "0.1.0",
  "description": "虚拟 Unity 教室：在模拟的 Unity 编辑器里，跟着教练一步一步学做游戏。",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.virtualunity.app",
    "productName": "Virtual Unity",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
