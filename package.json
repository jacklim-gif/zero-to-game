{
  "name": "zero-to-game",
  "productName": "Zero to Game",
  "version": "0.1.0",
  "description": "从零到游戏：在模拟的游戏编辑器里，跟着教练一步一步学做游戏。",
  "homepage": "https://github.com/jacklim-gif/zero-to-game",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacklim-gif/zero-to-game.git"
  },
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "demo": "electron scripts/demo.js",
    "vendor": "esbuild scripts/three-entry.js --bundle --minify --format=iife --legal-comments=eof --outfile=app/vendor/three.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.jacklimgif.zerotogame",
    "productName": "Zero to Game",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.28.2",
    "three": "0.186.1"
  }
}
